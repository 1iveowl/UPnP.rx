<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>6.0.0</VersionPrefix>
    <Authors>1iveowl</Authors>
    <Copyright>Copyright © 1iveowl</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/1iveowl/UPnP.rx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/1iveowl/UPnP.rx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Roslyn versions live here because drift between the analyzer, the code-fix and the
       test project is a real breakage. Referencing an OLDER Roslyn than the host compiler
       is always safe; never newer - that is the CS8032 load failure. Choose by which APIs
       are needed, not by reach: UPnP.Rx is net10.0-only, so every consumer builds on a
       .NET 10 SDK and the consumer-SDK floor is a non-issue. -->
  <!--
    Whether the analyzer PROJECT references have to be dropped for this build.

    A publish-shaped global property (`dotnet publish -p:PublishAot=true`, or
    `-p:PublishTrimmed=true`) is passed into the implicit restore, and UndefineProperties
    strips it from the BUILD but not from the RESTORE graph - where it reaches the
    netstandard2.0 analyzer projects and fails them: NETSDK1207 for AOT, NETSDK1124 for
    trimming ("Trimming assemblies requires .NET Core 3.0 or higher").

    Decided once here rather than repeated in the three projects that reference the
    analyzers, because the failure mode is silent until someone publishes: the AOT case was
    guarded in P4 and the trimming case was not, and CI found it at the release tag. Adding
    the next such property is now one line, in one file.

    Consumers of the PACKAGE are unaffected either way - package analyzers are not projects.
  -->
  <PropertyGroup>
    <UpnpRxSkipAnalyzerProjects
      Condition="'$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true'">true</UpnpRxSkipAnalyzerProjects>
  </PropertyGroup>

  <PropertyGroup>
    <RoslynVersion>4.8.0</RoslynVersion>
    <RoslynAnalyzersVersion>3.11.0</RoslynAnalyzersVersion>
    <RoslynTestingVersion>1.1.3</RoslynTestingVersion>
  </PropertyGroup>

  <!-- Time model rule 1: TimeProvider is the production clock. Wall-clock APIs are banned everywhere, including tests. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

</Project>
