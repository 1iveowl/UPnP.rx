@using System.Reactive.Linq
@using Sample.Dashboard.Client.Models
@using Sample.Dashboard.Client.Services
@inject DeviceStreamClient Stream

<div class="node">
    @foreach (var service in Node!.Services)
    {
        var serviceKey = $"{Node.Udn}#{service}";

        <div class="subhead svc-head" @onclick="() => ToggleServiceAsync(serviceKey, service)">
            <span class="chev">@(_openServices.Contains(serviceKey) ? "▾" : "▸")</span>
            <span class="urn">@Short(service)</span>
            <span class="muted" title="@service">@service</span>
        </div>

        @if (_openServices.Contains(serviceKey))
        {
            <div class="svc-detail">
                <div class="svc-live-bar">
                    <FluentButton Appearance="@(_watching.ContainsKey(serviceKey) ? Appearance.Accent : Appearance.Outline)"
                                  OnClick="() => ToggleWatch(serviceKey, service)">
                        @(_watching.ContainsKey(serviceKey) ? "Stop watching" : "Watch live")
                    </FluentButton>
                </div>

                @if (_liveEvents.TryGetValue(serviceKey, out var live) && live.Count > 0)
                {
                    <div class="svc-section">Live events</div>
                    @foreach (var e in live)
                    {
                        <div class="svc-row">
                            <span class="svc-name">@(e.Name ?? e.Kind)</span>
                            <span class="@(e.Kind == "PropertyChange" ? "" : "muted")">@Shorten(e.Value)</span>
                            @if (e.IsReplay)
                            {
                                <span class="muted">(replay)</span>
                            }
                            @if (e.Message is not null)
                            {
                                <span class="muted">@e.Message</span>
                            }
                        </div>
                    }
                }

                @if (!_details.TryGetValue(serviceKey, out var detail))
                {
                    <FluentProgressRing Style="width: 16px; height: 16px;" />
                }
                else if (detail.Error is not null)
                {
                    <div class="svc-error">@detail.Error</div>
                }
                else
                {
                    @if (detail.Actions.Length > 0)
                    {
                        <div class="svc-section">Actions (@detail.Actions.Length)</div>
                        @foreach (var action in detail.Actions)
                        {
                            <div class="svc-row">
                                <span class="svc-name">@action.Name</span>
                                @if (action.InArguments.Length > 0)
                                {
                                    <span class="muted">in: @string.Join(", ", action.InArguments)</span>
                                }
                                @if (action.OutArguments.Length > 0)
                                {
                                    <span class="muted">out: @string.Join(", ", action.OutArguments)</span>
                                }
                            </div>
                        }
                    }
                    @if (detail.StateVariables.Length > 0)
                    {
                        <div class="svc-section">State variables (@detail.StateVariables.Length)</div>
                        @foreach (var variable in detail.StateVariables)
                        {
                            <div class="svc-row">
                                <span class="svc-name">@variable.Name</span>
                                <span class="muted">@variable.DataType@(variable.AllowedValues.Length > 0
                                    ? $" ({string.Join("|", variable.AllowedValues)})" : "")</span>
                            </div>
                        }
                    }
                }
            </div>
        }
    }

    @foreach (var (child, index) in Node.Children.Select((c, i) => (c, i)))
    {
        var key = $"{child.Udn}#{index}";

        <div class="subhead" @onclick="() => Toggle(key)">
            <span class="chev">@(_open.Contains(key) ? "▾" : "▸")</span>
            <span>@Label(child)</span>
            <span class="muted">@Summary(child)</span>
        </div>

        @if (_open.Contains(key))
        {
            <DeviceNode Node="child" DeviceKey="@DeviceKey" />
        }
    }
</div>

@implements IDisposable

@code {
    [Parameter, EditorRequired]
    public DeviceNodeDto? Node { get; set; }

    /// <summary>The roster key of the root device - identifies the device on the server.</summary>
    [Parameter, EditorRequired]
    public string DeviceKey { get; set; } = string.Empty;

    private const int MaxLiveRows = 8;

    private readonly HashSet<string> _open = [];
    private readonly HashSet<string> _openServices = [];
    private readonly Dictionary<string, ServiceDetailDto> _details = [];
    private readonly Dictionary<string, IDisposable> _watching = [];
    private readonly Dictionary<string, List<ServiceEventDto>> _liveEvents = [];
    private IDisposable? _rescanSubscription;

    protected override void OnInitialized() =>
        _rescanSubscription = Stream.Rescanning
            .Where(rescanning => rescanning)
            .Subscribe(_ =>
            {
                // A rescan is rebuilding the roster: these services are already
                // gone server-side, so every live watch ends now (the last
                // watcher's disposal sends UNSUBSCRIBE on the device). The
                // grayed card stays visible until fresh devices arrive.
                foreach (var key in _watching.Keys.ToArray())
                {
                    StopWatching(key);
                }
            });

    private void ToggleWatch(string serviceKey, string serviceType)
    {
        if (_watching.Remove(serviceKey, out var existing))
        {
            existing.Dispose();              // last watcher -> UNSUBSCRIBE on the device
            return;
        }

        _liveEvents[serviceKey] = [];

        _watching[serviceKey] = Stream
            .ServiceEvents(DeviceKey, Node!.Udn, serviceType)
            .Subscribe(
                e =>
                {
                    var list = _liveEvents[serviceKey];

                    // A permanent refusal ends the stream right after its
                    // SubscriptionRefused event; the trailing StreamError echo
                    // carries the same reason - one row on screen is enough.
                    if (e.Kind == "StreamError" && list.FirstOrDefault()?.Kind == "SubscriptionRefused")
                    {
                        return;
                    }

                    list.Insert(0, e);

                    if (list.Count > MaxLiveRows)
                    {
                        list.RemoveAt(list.Count - 1);
                    }

                    _ = InvokeAsync(StateHasChanged);
                },
                error =>
                {
                    _liveEvents[serviceKey].Insert(0,
                        new ServiceEventDto("Error", null, null, 0, false, false, error.Message));
                    StopWatching(serviceKey);
                },
                () => StopWatching(serviceKey));
    }

    /// <summary>The stream ended (server-side or in error): reset the toggle.</summary>
    private void StopWatching(string serviceKey)
    {
        if (_watching.Remove(serviceKey, out var ended))
        {
            ended.Dispose();
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private static string Shorten(string? value) =>
        value is null ? "" : value.Length <= 80 ? value : value[..80] + "…";

    public void Dispose()
    {
        _rescanSubscription?.Dispose();

        foreach (var subscription in _watching.Values)
        {
            subscription.Dispose();
        }

        _watching.Clear();
    }

    private void Toggle(string key)
    {
        if (!_open.Remove(key))
        {
            _open.Add(key);
        }
    }

    private async Task ToggleServiceAsync(string serviceKey, string serviceType)
    {
        if (_openServices.Remove(serviceKey))
        {
            return;
        }

        _openServices.Add(serviceKey);

        if (!_details.ContainsKey(serviceKey))
        {
            var detail = await Stream.GetServiceDetailAsync(DeviceKey, Node!.Udn, serviceType);
            _details[serviceKey] = detail;
            StateHasChanged();
        }
    }

    private static string Label(DeviceNodeDto node) =>
        node.FriendlyName is { Length: > 0 } name ? name : Short(node.DeviceType ?? "(device)");

    private static string Summary(DeviceNodeDto node)
    {
        var parts = new List<string>();

        if (node.Services.Length > 0)
        {
            parts.Add($"{node.Services.Length} service(s)");
        }

        if (node.Children.Length > 0)
        {
            parts.Add($"{node.Children.Length} embedded");
        }

        var maker = $"{node.Manufacturer} {node.Model}".Trim();

        if (maker.Length > 0)
        {
            parts.Add(maker);
        }

        return string.Join(" · ", parts);
    }

    // "urn:schemas-upnp-org:service:WANIPConnection:2" -> "WANIPConnection:2"
    private static string Short(string urn)
    {
        var parts = urn.Split(':');
        return parts.Length >= 2 ? $"{parts[^2]}:{parts[^1]}" : urn;
    }
}
