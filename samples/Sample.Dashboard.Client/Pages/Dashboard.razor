@page "/"
@using Sample.Dashboard.Client.Components
@using Sample.Dashboard.Client.Services
@using Sample.Dashboard.Client.ViewModels
@* WASM-only, no prerender: the page's services (SignalR client, view model)
   exist only in the browser's DI container - server-side prerendering would
   try to resolve them on the server and fail. *@
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<DashboardViewModel>
@implements IDisposable
@inject DeviceStreamClient Stream

<PageTitle>UPnP.Rx dashboard</PageTitle>

@* The token source: flips every design token (and our token-based CSS) between
   light and dark. Mode System follows the OS/browser preference; OnLoaded and
   OnLuminanceChanged report the EFFECTIVE luminance so the toggle icon always
   matches what is on screen. The user's explicit choice persists in localStorage. *@
@* CustomColor gives the app its own accent (cyan-teal - every accent token
   follows it in both modes); swap for OfficeColor="OfficeColor.Teams" etc. to
   use the Office palette instead. *@
<FluentDesignTheme @bind-Mode="_mode"
                   CustomColor="#0891b2"
                   StorageName="upnprx-theme"
                   OnLoaded="OnThemeLoaded"
                   OnLuminanceChanged="OnThemeLuminance" />

<ErrorBoundary>
    <ChildContent>
        <div class="dash-header">
            <h1 class="dash-title">UPnP.Rx network dashboard</h1>
            <FluentBadge Appearance="Appearance.Accent">@ViewModel!.Count device(s)</FluentBadge>
            <FluentBadge>@ViewModel!.Status</FluentBadge>
            <div class="dash-tools">
                <FluentSearch Placeholder="Filter by name, maker or type…"
                              Immediate="true"
                              ImmediateDelay="200"
                              Value="@ViewModel!.Filter"
                              ValueChanged="@(value => ViewModel!.Filter = value ?? string.Empty)" />
                <FluentButton Appearance="Appearance.Stealth"
                              Title="@(_isDark ? "Switch to light mode" : "Switch to dark mode")"
                              aria-label="Toggle dark mode"
                              OnClick="ToggleTheme">
                    <FluentIcon Value="@ThemeIcon(_isDark)" />
                </FluentButton>
            </div>
        </div>

        @if (ViewModel!.Count == 0)
        {
            <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
                <FluentProgressRing />
                <FluentLabel>Listening for devices - they appear here live as they announce themselves…</FluentLabel>
            </FluentStack>
        }

        @foreach (var device in ViewModel!.Devices.ToArray())
        {
            <div class="device-card">
                <div class="device-head" @onclick="() => Toggle(device.Key)">
                    <span class="chev">@(_open.Contains(device.Key) ? "▾" : "▸")</span>
                    <div>
                        <div class="device-name">@(device.FriendlyName ?? "(unnamed device)")</div>
                        <div class="device-sub">@device.Manufacturer @device.Model</div>
                    </div>
                    <div class="device-badges">
                        <FluentBadge>@device.ServiceCount service(s)</FluentBadge>
                        @* DeviceCount includes the root device (the card itself);
                           the badge counts only what appears as sub-headers. *@
                        @if (device.DeviceCount > 1)
                        {
                            <FluentBadge Appearance="Appearance.Neutral">@(device.DeviceCount - 1) embedded</FluentBadge>
                        }
                    </div>
                </div>

                @if (_open.Contains(device.Key))
                {
                    <div class="device-body">
                        <dl class="identity">
                            <dt>Type</dt><dd class="urn">@device.Root.DeviceType</dd>
                            <dt>UDN</dt><dd class="urn">@device.Root.Udn</dd>
                            <dt>Location</dt>
                            <dd><a href="@device.Location" target="_blank">@device.Location</a></dd>
                        </dl>
                        <DeviceNode Node="device.Root" DeviceKey="@device.Key" />
                    </div>
                }
            </div>
        }
    </ChildContent>
    <ErrorContent Context="exception">
        <div class="error-panel">
            The dashboard hit an error: <strong>@exception.GetType().Name</strong> - @exception.Message
            <br />Reload the page to recover; the full stack is in the browser console (F12).
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    // Doc pattern (review F4): icons are created per render, never shared -
    // Icon instances can carry per-use state such as color.
    private static Icon ThemeIcon(bool isDark) => isDark
        ? new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.WeatherSunny()
        : new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.WeatherMoon();

    private readonly HashSet<string> _open = [];
    private DesignThemeModes _mode = DesignThemeModes.System;   // follow the OS until the user chooses
    private bool _isDark;

    private void Toggle(string key)
    {
        if (!_open.Remove(key))
        {
            _open.Add(key);
        }
    }

    // Both report the EFFECTIVE luminance - including what mode System resolved to.
    private void OnThemeLoaded(LoadedEventArgs args) => _isDark = args.IsDark;

    private void OnThemeLuminance(LuminanceChangedEventArgs args) => _isDark = args.IsDark;

    private void ToggleTheme() =>
        _mode = _isDark ? DesignThemeModes.Light : DesignThemeModes.Dark;

    protected override async Task OnInitializedAsync()
    {
        await Stream.StartAsync();
        await base.OnInitializedAsync();
    }

    // The base class cannot be shown to dispose the injected (transient) view
    // model; dispose it explicitly or its cache subscriptions outlive the page.
    // CompositeDisposable tolerates double-dispose if the base does it too.
    void IDisposable.Dispose() => ViewModel?.Dispose();
}
