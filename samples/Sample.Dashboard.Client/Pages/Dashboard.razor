@page "/"
@using System.Reactive.Concurrency
@using System.Reactive.Disposables
@using System.Reactive.Linq
@using Sample.Dashboard.Client.Components
@using Sample.Dashboard.Client.Services
@using Sample.Dashboard.Client.ViewModels
@* WASM-only, no prerender: the page's services (SignalR client, view model)
   exist only in the browser's DI container - server-side prerendering would
   try to resolve them on the server and fail. *@
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<DashboardViewModel>
@implements IDisposable
@inject DeviceStreamClient Stream
@inject IToastService ToastService

<PageTitle>UPnP.Rx dashboard</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <DashNav Active="network" />

        <div class="dash-header">
            <FluentBadge Appearance="Appearance.Accent">@ViewModel!.Count device(s)</FluentBadge>
            <FluentBadge>@ViewModel!.Status</FluentBadge>
            <div class="dash-tools">
                <FluentButton Appearance="Appearance.Outline"
                              Title="Search the network again - ends all live watches; the list resets when fresh devices answer"
                              Disabled="@_rescanning"
                              OnClick="@RescanAsync">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.ArrowClockwise())" Slot="start" />
                    Rescan
                </FluentButton>
                <FluentSearch Placeholder="Filter by name, maker or type…"
                              Immediate="true"
                              ImmediateDelay="200"
                              Value="@ViewModel!.Filter"
                              ValueChanged="@(value => ViewModel!.Filter = value ?? string.Empty)" />
            </div>
        </div>

        @if (_rescanning)
        {
            <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12" Style="margin-bottom: 0.75rem;">
                <FluentProgressRing Style="width: 20px; height: 20px;" />
                <FluentLabel>Rescanning… the list resets as soon as the first device answers the new search.</FluentLabel>
            </FluentStack>
        }

        @if (ViewModel!.Count == 0 && !_rescanning)
        {
            <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
                <FluentProgressRing />
                <FluentLabel>Scanning the network - devices appear here live as they announce themselves…</FluentLabel>
            </FluentStack>

            @if (ViewModel!.ShowHints)
            {
                <div class="hint-panel">
                    <strong>Nothing found yet - the server keeps scanning.</strong> Things to check meanwhile:
                    <ul>
                        <li>
                            <strong>On Windows</strong>, the built-in "SSDP Discovery" service (SSDPSRV) occupies
                            UDP 1900 and keeps clients from seeing responses. Pause it while discovering
                            (elevated prompt), and resume it when done:
                            <pre>net stop SSDPSRV
net start SSDPSRV</pre>
                        </li>
                        <li>Running the <em>server</em> inside Docker/WSL/a devcontainer? Multicast doesn't work there - run it on the host.</li>
                        <li>Is a VPN active? Its interface may not reach the LAN - try disconnecting.</li>
                        <li>Some networks block SSDP (AP isolation, IGMP snooping) - try wired or another network.</li>
                    </ul>
                </div>
            }
        }

        @foreach (var device in ViewModel!.Devices.ToArray())
        {
            @* Grayed + inert while rescanning: the cards are yesterday's list,
               kept on screen only until the first fresh device replaces them. *@
            <div class="device-card @(_rescanning ? "stale" : "")">
                <div class="device-head" @onclick="() => Toggle(device.Key)">
                    <span class="chev">@(_open.Contains(device.Key) ? "▾" : "▸")</span>
                    <div>
                        <div class="device-name">@CardLabel(device)</div>
                        <div class="device-sub">@device.Manufacturer @device.Model</div>
                    </div>
                    <div class="device-badges">
                        <FluentBadge>@device.ServiceCount service(s)</FluentBadge>
                        @* DeviceCount includes the root device (the card itself);
                           the badge counts only what appears as sub-headers. *@
                        @if (device.DeviceCount > 1)
                        {
                            <FluentBadge Appearance="Appearance.Neutral">@(device.DeviceCount - 1) embedded</FluentBadge>
                        }
                        <div @onclick:stopPropagation="true">
                            @* Feedback per state: spinner while the re-read runs,
                               a short-lived checkmark when the fresh description
                               landed, a toast when the device refused. *@
                            <FluentButton Appearance="Appearance.Stealth"
                                          Title="@(_refreshed.Contains(device.Key) ? "Description re-read" : "Re-read this device's description")"
                                          Disabled="@_refreshing.Contains(device.Key)"
                                          OnClick="@(() => RefreshDeviceAsync(device.Key))">
                                @if (_refreshing.Contains(device.Key))
                                {
                                    <FluentProgressRing Style="width: 14px; height: 14px;" />
                                }
                                else if (_refreshed.Contains(device.Key))
                                {
                                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Checkmark())" />
                                }
                                else
                                {
                                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.ArrowClockwise())" />
                                }
                            </FluentButton>
                        </div>
                    </div>
                </div>

                @if (_open.Contains(device.Key))
                {
                    <div class="device-body">
                        <dl class="identity">
                            <dt>Type</dt><dd class="urn">@device.Root.DeviceType</dd>
                            <dt>UDN</dt><dd class="urn">@device.Root.Udn</dd>
                            <dt>Location</dt>
                            <dd><a href="@device.Location" target="_blank">@device.Location</a></dd>
                        </dl>
                        <DeviceNode Node="device.Root" DeviceKey="@device.Key" />

                        <div class="svc-section">
                            SSDP activity (log)
                            <span class="muted">· @Stream.ActivityCountFor(device.Key) message(s) since page load</span>
                        </div>
                        @if (Stream.ActivityFor(device.Key) is { Count: > 0 } activity)
                        {
                            <div class="activity-feed">
                                @foreach (var row in activity)
                                {
                                    var rowKey = $"{row.Seen.UtcTicks}#{row.Usn}";

                                    <div class="svc-row svc-action" @onclick="() => ToggleActivity(rowKey)">
                                        <span class="chev">@(_expandedActivity.Contains(rowKey) ? "▾" : "▸")</span>
                                        <span class="muted">@row.Seen.ToLocalTime().ToString("HH:mm:ss")</span>
                                        <span class="svc-name">@ActivityLabel(row.Kind)</span>
                                        @if (row.Kind != "ByeBye")
                                        {
                                            <span class="muted">BOOTID @row.BootId@(row.MaxAgeSeconds > 0 ? $", max-age {row.MaxAgeSeconds}" : "")</span>
                                        }
                                    </div>

                                    @if (_expandedActivity.Contains(rowKey))
                                    {
                                        <div class="activity-detail">
                                            <div class="svc-row"><span class="svc-name">USN</span><span class="urn">@row.Usn</span></div>
                                            @if (row.Server is not null)
                                            {
                                                <div class="svc-row"><span class="svc-name">SERVER</span><span>@row.Server</span></div>
                                            }
                                            @if (row.Location is not null)
                                            {
                                                <div class="svc-row"><span class="svc-name">LOCATION</span><span class="urn">@row.Location</span></div>
                                            }
                                            @if (row.ConfigId is not null)
                                            {
                                                <div class="svc-row"><span class="svc-name">CONFIGID</span><span>@row.ConfigId</span></div>
                                            }
                                            @if (row.HasParsingError)
                                            {
                                                <div class="svc-row svc-error">degraded: parts of this announcement did not parse</div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="muted activity-empty">
                                Waiting for traffic - devices re-announce every few minutes
                                (half their max-age), and the log is live-only.
                                <FluentButton Appearance="Appearance.Outline"
                                              Title="Send one M-SEARCH - devices answer within seconds; nothing is reset"
                                              OnClick="@(() => Stream.ProbeAsync())">
                                    Solicit responses now
                                </FluentButton>
                                <span>(The page-level Rescan also resets the whole list; this only asks.)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </ChildContent>
    <ErrorContent Context="exception">
        <div class="error-panel">
            The dashboard hit an error: <strong>@exception.GetType().Name</strong> - @exception.Message
            <br />Reload the page to recover; the full stack is in the browser console (F12).
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private readonly HashSet<string> _open = [];
    private bool _rescanning;
    private IDisposable? _rescanSubscription;
    private IDisposable? _activitySubscription;

    private readonly HashSet<string> _expandedActivity = [];

    private void ToggleActivity(string rowKey)
    {
        // Rows rotate out of the ring but their expansion keys would not -
        // crude cap so a very long session cannot accumulate click residue.
        if (_expandedActivity.Count > 200)
        {
            _expandedActivity.Clear();
        }

        if (!_expandedActivity.Remove(rowKey))
        {
            _expandedActivity.Add(rowKey);
        }
    }

    private static string ActivityLabel(string kind) => kind switch
    {
        "SearchResponse" => "search response",
        "ByeBye" => "byebye",
        _ => "alive"
    };

    private void Toggle(string key)
    {
        if (!_open.Remove(key))
        {
            _open.Add(key);
        }
    }

    // Open-state survives the rescan on purpose: a device that answers the new
    // search keeps its key, so its card comes back the way the user left it.
    private Task RescanAsync() => Stream.RescanAsync();

    private readonly HashSet<string> _refreshing = [];
    private readonly HashSet<string> _refreshed = [];
    private readonly CompositeDisposable _checkmarkTimers = new();

    private async Task RefreshDeviceAsync(string key)
    {
        if (!_refreshing.Add(key))
        {
            return;
        }

        try
        {
            var error = await Stream.RefreshDeviceAsync(key);

            if (error is not null)
            {
                ToastService.ShowError($"Re-reading the description failed: {error}");
                return;
            }

            _refreshed.Add(key);
            _checkmarkTimers.Add(Observable
                .Timer(TimeSpan.FromSeconds(1.5), DefaultScheduler.Instance)
                .Subscribe(tick =>
                {
                    _refreshed.Remove(key);
                    _ = InvokeAsync(StateHasChanged);
                }));
        }
        finally
        {
            _refreshing.Remove(key);
        }
    }

    // Devices occasionally serve a description without a friendlyName (seen on
    // Sonos mid-boot) - fall back to something identifying rather than "(unnamed)".
    private static string CardLabel(DeviceDto device)
    {
        if (device.FriendlyName is { Length: > 0 } name)
        {
            return name;
        }

        var host = Uri.TryCreate(device.Location, UriKind.Absolute, out var uri) ? uri.Host : device.Location;

        return device.Model is { Length: > 0 } model ? $"{model} ({host})" : $"Device at {host}";
    }

    protected override async Task OnInitializedAsync()
    {
        _rescanSubscription = Stream.Rescanning.Subscribe(rescanning =>
        {
            _rescanning = rescanning;
            _ = InvokeAsync(StateHasChanged);
        });

        // Re-render when activity arrives for a card the user has open.
        _activitySubscription = Stream.SsdpActivity.Subscribe(row =>
        {
            if (_open.Contains(row.DeviceKey))
            {
                _ = InvokeAsync(StateHasChanged);
            }
        });

        await Stream.StartAsync();
        await base.OnInitializedAsync();
    }

    // The base class cannot be shown to dispose the injected (transient) view
    // model; dispose it explicitly or its cache subscriptions outlive the page.
    void IDisposable.Dispose()
    {
        _rescanSubscription?.Dispose();
        _activitySubscription?.Dispose();
        _checkmarkTimers.Dispose();
        ViewModel?.Dispose();
    }
}
