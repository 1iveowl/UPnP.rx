<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script>
        // Surface any client-side unhandled error ON the page (not only in the
        // F12 console): Blazor writes unhandled exceptions via console.error,
        // and boot failures arrive as window error / unhandledrejection events.
        (function () {
            function show(message) {
                var details = document.getElementById('blazor-error-details');
                var bar = document.getElementById('blazor-error-ui');
                if (details && bar && !details.textContent) {
                    details.textContent = message;
                    bar.style.display = 'block';
                }
            }
            var original = console.error;
            console.error = function () {
                original.apply(console, arguments);
                var text = Array.prototype.map.call(arguments, String).join(' ');
                if (text.indexOf('Unhandled exception') >= 0 || text.indexOf('crit:') >= 0) {
                    show(text.split('\n').slice(0, 8).join('\n'));
                }
            };
            window.addEventListener('error', function (e) { show(e.message + ' (' + e.filename + ':' + e.lineno + ')'); });
            window.addEventListener('unhandledrejection', function (e) { show(String(e.reason)); });
        })();
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
