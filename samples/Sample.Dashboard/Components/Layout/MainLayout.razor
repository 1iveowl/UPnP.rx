@inherits LayoutComponentBase

<main style="padding: 1.5rem; max-width: 1200px; margin: 0 auto;">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    <strong>An unhandled error has occurred.</strong>
