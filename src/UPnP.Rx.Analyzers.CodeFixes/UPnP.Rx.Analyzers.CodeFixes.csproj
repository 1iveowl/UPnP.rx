<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="$(RoslynAnalyzersVersion)" PrivateAssets="all" />
  </ItemGroup>

  <!-- The two analyzer assemblies cannot reference each other: a reverse reference
       cycles with packing. Diagnostic IDs and code-fix property keys are shared by
       linking the source file instead. -->
  <ItemGroup>
    <Compile Include="../UPnP.Rx.Analyzers/DiagnosticIds.cs" Link="DiagnosticIds.cs" />
  </ItemGroup>

</Project>
