<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- XML docs on every public member, enforced; docs ship in the nupkg -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Description>A modern, functional, Rx-based UPnP control point for .NET: discover devices, browse their services, call their actions — as observables and immutable records. Includes an IGD port-mapping client.</Description>
    <PackageTags>upnp;ssdp;igd;port-mapping;nat;discovery;soap;rx;reactive;observable</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UPnP.Rx.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="SSDP.UPnP.PCL" Version="7.0.2" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

</Project>
