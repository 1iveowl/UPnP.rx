<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- XML docs on every public member, enforced; docs ship in the nupkg -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Description>A modern, functional, Rx-based UPnP control point for .NET: discover devices, browse their services, call their actions — as observables and immutable records. Includes an IGD port-mapping client with auto-renewing leases.</Description>
    <PackageTags>upnp;ssdp;igd;port-mapping;nat;discovery;soap;rx;reactive;observable</PackageTags>
    <PackageIcon>1iveowl-logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/1iveowl-logo.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UPnP.Rx.Tests" />
  </ItemGroup>

  <!-- The SCPD the generated WANIPConnection wrapper is built from. Checked in on purpose:
       it is the standardized service template, and the generator is honest about that being
       what it describes rather than any particular device. Packed so consumers can read the
       exact document their wrapper came from. -->
  <ItemGroup>
    <AdditionalFiles Include="Scpd/WANIPConnection1.scpd.xml" />
    <None Include="Scpd/WANIPConnection1.scpd.xml" Pack="true" PackagePath="scpd/" />
  </ItemGroup>

  <PropertyGroup>
    <!-- No reflection, no serialization, no dynamic code: say so and let the
         trim/AOT analyzers hold us to it (4.1 plan, ergonomics batch). -->
    <!-- Generated sources on disk, so they are greppable when a generated member turns up
         in the public-API ledger. Left at the default path under obj/: anywhere inside the
         project directory gets globbed back in as compile input, and every generated file
         is then compiled twice. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- The analyzers ship inside this package rather than a separate one with a dependency
       edge: that edge puts the analyzer project into every consuming project's reference
       graph, which Visual Studio reports as LimitedFunctionality and a broken reference.
       Tried in a sibling repo, abandoned there.

       OutputItemType="Analyzer" is what makes the library analyse its own code.
       ReferenceOutputAssembly="false" keeps the analyzer assemblies out of the compile
       reference set (and out of the NuGet dependency list).

       The Condition matters: `dotnet publish /p:PublishAot=true` passes PublishAot as a
       global property into the implicit restore, and UndefineProperties strips it from the
       BUILD but not from the RESTORE graph - where it reaches these netstandard2.0
       projects and fails with NETSDK1207. Consumers of the package are unaffected;
       package analyzers are not projects. -->
  <ItemGroup Condition="'$(PublishAot)' != 'true'">
    <ProjectReference Include="../UPnP.Rx.Analyzers/UPnP.Rx.Analyzers.csproj"
                      PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="../UPnP.Rx.Analyzers.CodeFixes/UPnP.Rx.Analyzers.CodeFixes.csproj"
                      PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../UPnP.Rx.Analyzers/bin/$(Configuration)/netstandard2.0/UPnP.Rx.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../UPnP.Rx.Analyzers.CodeFixes/bin/$(Configuration)/netstandard2.0/UPnP.Rx.Analyzers.CodeFixes.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="SimpleHttpListener.Rx" Version="7.6.0" />
    <PackageReference Include="SSDP.UPnP.PCL" Version="10.0.0" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

</Project>
